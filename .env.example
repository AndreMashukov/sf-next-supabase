# Supabase (local defaults from `supabase start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Fastify API (Dockerized Node backend)
# When set, the web client calls `${NEXT_PUBLIC_API_URL}/api/v1/*`.
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001
API_PORT=3001
API_HOST=0.0.0.0

# Fastify server-side Supabase access
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase Storage (S3-compatible; values printed by `supabase start`)
# When running the API inside Docker against local Supabase, use host.docker.internal:
# STORAGE_S3_ENDPOINT=http://host.docker.internal:54321/storage/v1/s3
STORAGE_BUCKET=documents
STORAGE_S3_ENDPOINT=http://127.0.0.1:54321/storage/v1/s3
STORAGE_S3_ACCESS_KEY=your-s3-access-key
STORAGE_S3_SECRET_KEY=your-s3-secret-key
STORAGE_S3_REGION=local

TOGETHER_AI_API_KEY=your-together-ai-api-key

# Global workspace agent memory (LangGraph Postgres checkpoints + pgvector)
# Defaults to local Supabase Postgres on port 54322 when unset in development.
AGENT_MEMORY_ENABLED=true
AGENT_MEMORY_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
AGENT_MEMORY_MAX_PROMPT_TOKENS=8000
AGENT_MEMORY_MAX_MESSAGES=40
AGENT_MEMORY_MATCH_COUNT=6
AGENT_MEMORY_MIN_SIMILARITY=0.72
