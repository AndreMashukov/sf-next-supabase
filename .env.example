# Supabase (local defaults from `supabase start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Edge Functions (server-side only; set in Supabase secrets for deployed functions)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase Storage (S3-compatible; values printed by `supabase start`)
STORAGE_BUCKET=documents
STORAGE_S3_ENDPOINT=http://127.0.0.1:54321/storage/v1/s3
STORAGE_S3_ACCESS_KEY=your-s3-access-key
STORAGE_S3_SECRET_KEY=your-s3-secret-key
STORAGE_S3_REGION=local

TOGETHER_AI_API_KEY=your-together-ai-api-key
