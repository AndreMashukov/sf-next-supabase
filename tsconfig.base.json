{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@sf/shared-types": ["libs/shared-types/src/index.ts"],
      "@sf/validation": ["libs/validation/src/index.ts"],
      "@sf/gcs": ["libs/gcs/src/index.ts"],
      "@sf/document-agent": ["libs/document-agent/src/index.ts"],
      "@sf/api-domain": ["libs/api-domain/src/index.ts"],
      "@sf/api-application": ["libs/api-application/src/index.ts"],
      "@sf/api-infra-supabase": ["libs/api-infra-supabase/src/index.ts"],
      "@sf/api-infra-storage": ["libs/api-infra-storage/src/index.ts"],
      "@sf/api-infra-ai": ["libs/api-infra-ai/src/index.ts"],
      "@sf/api-routes": ["libs/api-routes/src/index.ts"],
      "@sf/directory-agent": ["libs/directory-agent/src/index.ts"],
      "shared-types": ["./libs/shared-types/src/index.ts"],
      "validation": ["./libs/validation/src/index.ts"],
      "gcs": ["./libs/gcs/src/index.ts"]
    },
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "exclude": ["node_modules", "tmp"]
}
