  "scripts": {
    "dev": "nx run-many -t dev --parallel=2",
    "dev:web": "nx dev web",
    "dev:api": "nx serve api",
    "build": "nx run-many -t build",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "typecheck": "nx run-many -t typecheck",
    "supabase:start": "cd apps/backend && supabase start",
    "supabase:stop": "cd apps/backend && supabase stop",
    "supabase:reset": "cd apps/backend && supabase db reset",
    "supabase:gen-types": "cd apps/backend && supabase gen types typescript --local > ../../libs/shared-types/src/database.types.ts",
    "test:document-agent": "vitest run --config libs/document-agent/vitest.config.mts"
  },
