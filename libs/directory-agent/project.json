{
  "name": "directory-agent",
  "$schema": "../../node_modules/nx/schemas/project.json",
  "sourceRoot": "libs/directory-agent/src",
  "projectType": "library",
  "tags": ["scope:shared"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/directory-agent",
        "main": "libs/directory-agent/src/index.ts",
        "tsConfig": "libs/directory-agent/tsconfig.lib.json",
        "assets": ["libs/directory-agent/*.md"]
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config libs/directory-agent/vitest.config.mts",
        "cwd": "."
      }
    }
  }
}
