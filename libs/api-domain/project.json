{
  "name": "api-domain",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/api-domain/src",
  "projectType": "library",
  "tags": ["scope:api", "type:domain"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/api-domain",
        "main": "libs/api-domain/src/index.ts",
        "tsConfig": "libs/api-domain/tsconfig.lib.json"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --config libs/api-domain/vitest.config.mts",
        "cwd": "."
      }
    }
  }
}
